# build output
/build/bin/
/dist/
*.exe
*.exe~
*.app
*.dylib

# Wails regenerates these bindings on every build.
/frontend/wailsjs/

# Windows resources (icon, DPI manifest, version info), generated by
# package-windows.sh from build/windows/ and wails.json.
*.syso
/build/windows/info.generated.json

# local settings / profiles (may hold secrets — never commit)
*.local.json
settings.json
profiles.json

# routing dataset, downloaded by package-windows.sh
rules.dat

# editor / OS
.idea/
.vscode/
.DS_Store
